AWS_USER_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=465
EMAIL_FROM=

# Admin credentials – base64-encoded bcrypt hash (see readme)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<base64 output of the command in the readme>
AUTH_SECRET="your-32-char-random-secret"

# Set to true to print full SMTP traces (includes email contents). Local debugging only.
SMTP_DEBUG=false
